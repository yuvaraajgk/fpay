# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/freelancepay

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Totals below this use Payment Links; at/above use Razorpay Orders (higher limits than ~₹30k links)
PAYMENT_LINK_MAX_INR=29000

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=freelancepay-invoices

# Application Configuration
CLIENT_URL=http://localhost:3000
PORT=5001

# Email (optional — required to email clients the payment link when you "Send invoice")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Your Startup <billing@example.com>"
# Optional: also send Razorpay's own payment-link notification email
# RAZORPAY_NOTIFY_EMAIL=true
